PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/kingshot?ssl=true&replicaSet=atlas-xxx&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=change-me-long-random
JWT_DAYS=365d
BCRYPT_ROUNDS=12

# Required for /api/player — also set this in Vercel Environment Variables
MIGHTPULSE_API_KEY=kss_your_key_here

CLIENT_URL=https://kingshot-calculator.vercel.app
CORS_ORIGINS=https://kingshot-calculator.vercel.app,http://localhost:3000,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true

RATE_LIMIT_API=400
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=120
JSON_LIMIT=1mb
