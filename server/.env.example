PORT=5000
NODE_ENV=development

# MongoDB (replace with your Atlas URI)
MONGODB_URI=mongodb://USER:PASSWORD@cluster0-shard-00-00.ulu8y.mongodb.net:27017,cluster0-shard-00-01.ulu8y.mongodb.net:27017,cluster0-shard-00-02.ulu8y.mongodb.net:27017/kingshot?ssl=true&replicaSet=atlas-134yj6-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=replace-with-long-random-secret
JWT_DAYS=365d
BCRYPT_ROUNDS=12

# REQUIRED for /api/player (local + Vercel dashboard)
MIGHTPULSE_API_KEY=kss_your_key_here

# Local + production origins (Vercel must also have these in Dashboard)
CLIENT_URL=https://kingshot-calculator.vercel.app
CORS_ORIGINS=https://kingshot-calculator.vercel.app,http://localhost:3000,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true

RATE_LIMIT_API=400
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=120
JSON_LIMIT=1mb
