PORT=5000
NODE_ENV=development

# MongoDB connection (never commit real credentials)
MONGODB_URI=mongodb://USER:PASSWORD@host:27017/kingshot?retryWrites=true&w=majority

# Strong random secret — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
# Access token lifetime (prefer 7d–30d, not 365d)
JWT_DAYS=30d
BCRYPT_ROUNDS=12

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CLIENT_URL=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false

# Optional CSP connect-src extras
API_CSP_CONNECT=

# Request body size
JSON_LIMIT=2mb
