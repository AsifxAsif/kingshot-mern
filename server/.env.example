PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kingshot?retryWrites=true&w=majority
JWT_SECRET=dev-only-change-me-to-long-random-string-32chars
JWT_DAYS=7d
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_VERCEL_PREVIEWS=true
RATE_LIMIT_API=400
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=120
JSON_LIMIT=1mb
